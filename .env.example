# ========================================================
# ENTORNO Y PUERTOS
# ========================================================
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
QR_SERVICE_PORT=4001
JWT_SECRET=super_secret_jwt_key_crm_2026_xyz123

# ========================================================
# BASE DE DATOS (POSTGRESQL CON PGVECTOR)
# ========================================================
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/whatsapp_crm?schema=public"
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=whatsapp_crm
DB_PORT=5432

# ========================================================
# REDIS (BULLMQ DEBOUNCE BUFFER & CACHE)
# ========================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_URL="redis://:redis123@localhost:6379"

# ========================================================
# INTELIGENCIA ARTIFICIAL MULTIMODAL (GOOGLE GEMINI)
# ========================================================
GEMINI_API_KEY=tu_clave_de_gemini_aqui
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ========================================================
# WHATSAPP GATEWAY (META CLOUD API OFICIAL)
# ========================================================
META_GRAPH_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=crm_whatsapp_verify_token_secure_99
META_APP_SECRET=tu_meta_app_secret

# ========================================================
# WHATSAPP GATEWAY (MICROSERVICIO QR / BAILEYS)
# ========================================================
QR_SERVICE_URL=http://localhost:4001
QR_WEBHOOK_SECRET=baileys_internal_secret_key_888

# ========================================================
# ALMACENAMIENTO MULTIMEDIA (CLOUDFLARE R2 O MINIO S3)
# ========================================================
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=whatsapp-crm-media
S3_PUBLIC_URL=http://localhost:9000/whatsapp-crm-media
# Para producción con Cloudflare R2:
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_PUBLIC_URL=https://media.tudominio.com
